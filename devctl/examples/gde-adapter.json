{
  "version": 1,
  "name": "gde-adapter",
  "cluster": {
    "context": "internal-test",
    "namespace": "kube-system",
    "domain": "cluster.local",
    "sshHost": "developer-node"
  },
  "network": {
    "backend": "telepresence",
    "transport": "kubectl",
    "managerNamespace": "kube-system",
    "gatewayNamespace": "kube-system",
    "gatewayDeployment": "dev-egress",
    "authEnv": "DEVCTL_GATEWAY_AUTH",
    "fingerprint": "REPLACE_WITH_ADMIN_PINNED_CHISEL_FINGERPRINT",
    "routeCIDRs": [
      "10.96.0.0/12",
      "10.244.0.0/16"
    ],
    "bypassCIDRs": [
      "192.0.2.10/32"
    ],
    "clusterDNS": "10.96.0.10",
    "fallbackDNS": "192.0.2.53",
    "dnsSuffixes": []
  },
  "source": {
    "deployment": "gde-adapter",
    "container": "gde-adapter",
    "envAllow": [
      "SPRING_DATASOURCE_URL",
      "SPRING_DATASOURCE_USERNAME",
      "SPRING_DATASOURCE_PASSWORD",
      "SPRING_DATA_REDIS_HOST",
      "SPRING_DATA_REDIS_PORT",
      "SPRING_DATA_REDIS_PASSWORD"
    ],
    "requiredEnv": [
      "SPRING_DATASOURCE_URL",
      "SPRING_DATASOURCE_USERNAME",
      "SPRING_DATASOURCE_PASSWORD"
    ],
    "overrides": {
      "SERVER_ADDRESS": "127.0.0.1",
      "SERVER_PORT": "8080",
      "SPRING_CONFIG_ADDITIONAL_LOCATION": "file:${CONFIG_DIR}/application-cluster.yaml",
      "SPRING_KAFKA_LISTENER_AUTO_STARTUP": "false",
      "SPRING_RABBITMQ_LISTENER_SIMPLE_AUTO_STARTUP": "false",
      "SPRING_RABBITMQ_LISTENER_DIRECT_AUTO_STARTUP": "false",
      "SPRING_FLYWAY_ENABLED": "false",
      "SPRING_LIQUIBASE_ENABLED": "false"
    },
    "files": [
      {
        "kind": "configmap",
        "name": "gde-adapter-config",
        "key": "application.yaml",
        "path": "application-cluster.yaml"
      }
    ]
  },
  "application": {
    "workDir": "C:/src/gde-adapter",
    "command": [
      ".\\mvnw.cmd",
      "spring-boot:run",
      "-Dspring-boot.run.jvmArguments=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=127.0.0.1:5005"
    ],
    "healthURL": "http://127.0.0.1:8080/actuator/health",
    "healthStatus": 200,
    "startupSeconds": 180,
    "backgroundTasksReviewed": false,
    "tests": {
      "smoke": [
        "powershell.exe",
        "-NoProfile",
        "-File",
        "C:/devctl/scripts/gde-smoke.ps1",
        "-Config",
        "C:/devctl/gde-smoke.local.json"
      ]
    },
    "testTimeoutSeconds": 300,
    "inheritEnv": []
  },
  "dependencies": [
    {
      "name": "gaussdb",
      "address": "gaussdb.kube-system.svc.cluster.local:5432"
    },
    {
      "name": "redis",
      "address": "redis.kube-system.svc.cluster.local:6379"
    },
    {
      "name": "minio",
      "address": "minio.kube-system.svc.cluster.local:9000"
    }
  ]
}
